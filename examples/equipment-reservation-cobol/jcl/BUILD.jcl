//EQBUILD  JOB (1),'BUILD EQ RESERVATION',CLASS=A,MSGCLASS=X
//COMPILE  EXEC PGM=IGYCRCTL,REGION=0M
//STEPLIB  DD DSN=IBM.COBOL.V63.SIGYCOMP,DISP=SHR
//SYSLIB   DD DSN=EQ.RESERVATION.COPY,DISP=SHR
//         DD DSN=SYS.DB2.V12.SDSNMACS,DISP=SHR
//SYSIN    DD DSN=EQ.RESERVATION.CBL(EQWEB00),DISP=SHR
//SYSLIN   DD DSN=&&OBJ,DISP=(NEW,PASS),UNIT=SYSALLDA
//SYSPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//*
//* Repeat the COMPILE step for EQACT00, EQCAT00, EQSCH00, EQOPS00,
//* and EQHND00. A site-specific precompile step is required before this
//* compile step because these programs contain DB2 SQL.
//*
//BIND     EXEC PGM=DSNHCP,REGION=0M
//STEPLIB  DD DSN=SYS.DB2.V12.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=EQ.RESERVATION.DBRM,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=EQ.RESERVATION.SYSPUNCH,DISP=(NEW,CATLG),
//            UNIT=SYSALLDA,SPACE=(TRK,(5,5))
